MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=se_store
ADMIN_EMAIL=admin@example.com
# Set the admin password. No minimum length is enforced.
ADMIN_PASSWORD=
